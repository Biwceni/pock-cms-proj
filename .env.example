DATABASE_URI=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Required. Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
PAYLOAD_SECRET=
# Opcional; os testes usam somente o schema payload_test. Se omitido, usam DATABASE_URI.
# PAYLOAD_TEST_DATABASE_URI=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Required only to run the Phase 2 seed; use an existing admin account.
# PAYLOAD_SEED_EMAIL=admin@example.com
# PAYLOAD_SEED_PASSWORD=replace-with-an-admin-password
# The production smoke test uses only payload_test, with random credentials and records.
# PAYLOAD_SCHEMA_NAME=payload_test
